    {
      "title": "US orders federal agencies to remove DeepSeek AI, including products built on it",
      "summary": "DHS ordered federal civilian agencies to stop buying DeepSeek products and services and remove them from government systems, and the order also covers third-party products built with DeepSeek technology, with exceptions by request.",
      "url": "https://techcrunch.com/2026/10/20/us-orders-federal-agencies-to-remove-chinas-deepseek-ai-from-their-systems/",
      "date_published": "2026-10-20",
      "source": "TechCrunch",
      "tag": "policy",
      "why_it_matters_for_FDEs": "If you deploy for US federal customers, audit every stack for DeepSeek models or DeepSeek-based components now, including open weights hosted by third parties.",
      "verified": "2026-10-21"
    },
    {
      "title": "DeepSeek open-sources DeepInfer, its production inference stack",
      "summary": "DeepSeek released DeepInfer under Apache-2.0, the vLLM-based inference framework it uses to serve DeepSeek-V4.1-Flash at scale, though its most optimized KV cache and load balancing are not included.",
      "url": "https://github.com/deepseek-ai/DeepInfer",
      "date_published": "2026-10-20",
      "source": "DeepSeek (GitHub)",
      "tag": "open-source",
      "why_it_matters_for_FDEs": "A production-proven reference for self-hosted inference that can cut serving costs for customers running open models, but check the new federal DeepSeek ban before proposing it to government customers.",
      "verified": "2026-10-21"
    },
    {
      "title": "Microsoft: treat deployed AI agents as insider threats",
      "summary": "Microsoft's official blog argues that frontier models, whatever their origin, can't be trusted, and that enterprises need guardian agents that watch and moderate every action of their own agents before it happens, extending its Project Perception security system to internal agents.",
      "url": "https://blogs.microsoft.com/blog/2026/10/19/securing-the-agentic-insider/",
      "date_published": "2026-10-19",
      "source": "Microsoft",
      "tag": "agent-infra",
      "why_it_matters_for_FDEs": "Enterprise security teams will now expect agent deployments to come with per-action monitoring, least-privilege tool access and audit trails, so build those into the design rather than bolting them on.",
      "verified": "2026-10-20"
    },
    {
      "title": "GitHub Copilot retired GPT-5.5, GPT-5.4, Gemini 3.7 Flash and Grok 4.5 on Oct 19",
      "summary": "GitHub deprecated six models across Copilot Chat, agent mode and completions on Oct 19, 2026, pointing users to GPT-6.1 Sol, GPT-6 Luna, Gemini 3.8 Flash and Grok 4.7 instead.",
